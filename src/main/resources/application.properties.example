# MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/db_name?verifyServerCertificate=false&useSSL=false&requireSSL=false&useLegacyDatetimeCode=false&serverTimezone=UTC
spring.datasource.username=db_username
spring.datasource.password=db_password

# Hibernate
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update